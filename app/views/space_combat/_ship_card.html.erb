<%
  ship = participant.participant
  is_mj = current_user&.group&.name == "MJ"
  can_act = participant.controlled_by?(current_user)
  is_current = current_participant == participant
  enemies = participants.reject { |other| participant.allied_with?(other) }
  live_enemies = enemies.reject(&:out_of_combat?)
  side_class = participant.player? ? "border-info" : "border-danger"
  weapons = SpaceCombatStats.weapons_for(ship)
  crew_position = participant.crew_position_for(current_user)
%>

<div class="card space-ship-card <%= side_class %> <%= 'opacity-50' if participant.has_played? || participant.out_of_combat? %>"
     id="ship_card_<%= participant.id %>">

  <div class="card-header d-flex justify-content-between align-items-center">
    <div>
      <strong style="color: <%= participant.player? ? '#17a2b8' : '#dc3545' %>;"><%= ship.name %></strong>
      <% if participant.action_order %>
        <span class="badge bg-dark ms-1">#<%= participant.action_order %></span>
      <% end %>
      <% if is_current %><span class="badge bg-info ms-1">Actif</span><% end %>
      <% if participant.has_played? %><span class="badge bg-secondary ms-1">Joué</span><% end %>
      <% if participant.stealth? %>
        <span class="badge <%= participant.detected? ? 'bg-warning text-dark' : 'bg-dark' %> ms-1">
          <%= participant.detected? ? "Furtif (détecté)" : "Furtif" %>
        </span>
      <% end %>
      <% if participant.has_fled? %><span class="badge bg-dark ms-1">A quitté le combat</span><% end %>
      <div>
        <small class="text-muted">
          <%= EnemyShip::SCALE_NAMES[participant.scale_value] %>
          <% if crew_position.present? %> · votre poste : <%= crew_position %><% end %>
        </small>
      </div>
    </div>
    <% if is_mj %>
      <button class="btn btn-outline-danger btn-sm"
              data-action="click->space-combat#removeParticipant"
              data-participant-id="<%= participant.id %>"
              data-ship-name="<%= ship.name %>">&times;</button>
    <% end %>
  </div>

  <div class="card-body p-2">
    <%# Points de blindage %>
    <div class="d-flex align-items-center justify-content-between mb-2">
      <small class="text-light me-2">PB</small>
      <%= render "space_combat/ship_stat_value",
                 participant: participant, ship: ship, field: "hp_current",
                 current: ship.hp_current, max: ship.hp_max, editable: can_act %>
    </div>

    <%# Caractéristiques de vol %>
    <div class="ship-dice-grid mb-2">
      <div><small class="text-light">Coque</small>
        <span class="fw-bold"><%= dice_label(participant.hull_dice) %></span></div>
      <div><small class="text-light">Écrans</small>
        <% if participant.has_shields? %>
          <% if participant.shields_active? %>
            <span class="fw-bold text-primary"><%= dice_label(SpaceCombatStats.ship_dice(ship, :shields)) %></span>
          <% else %>
            <span class="fw-bold text-muted" style="text-decoration: line-through;"
                  title="Rechargés au tour <%= participant.shields_down_until_turn || combat.turn + 1 %>">
              <%= dice_label(SpaceCombatStats.ship_dice(ship, :shields)) %>
            </span>
          <% end %>
        <% else %>
          <span class="text-muted">—</span>
        <% end %>
      </div>
      <div><small class="text-light">Maniabilité</small>
        <span class="fw-bold <%= 'text-danger' if participant.thruster_hits.positive? %>">
          <%= dice_label(participant.handling_dice) %>
        </span></div>
      <div><small class="text-light">Vitesse</small>
        <span class="fw-bold"><%= dice_label(participant.speed_dice) %></span></div>
    </div>

    <%# Statuts %>
    <div class="mb-2">
      <% participant.status_summary.each do |label| %>
        <span class="badge <%= label == 'Intact' ? 'bg-success' : 'bg-danger' %> me-1"
              style="font-size: 0.7rem;"><%= label %></span>
      <% end %>
      <% if participant.defense_malus.positive? %>
        <span class="badge bg-warning text-dark me-1" style="font-size: 0.7rem;">
          Défense -<%= participant.defense_malus %>D
        </span>
      <% end %>
      <% if participant.pending_repair.positive? %>
        <span class="badge bg-info me-1" style="font-size: 0.7rem;">
          +<%= participant.pending_repair %> PB au prochain tour
        </span>
      <% end %>
      <% if participant.astrogation_started? %>
        <span class="badge bg-primary me-1" style="font-size: 0.7rem;">
          Astrogation : <%= participant.hyperspace_ready? ? "prête" : "#{participant.astrogation_turns} tour(s)" %>
        </span>
      <% end %>
    </div>

    <%# Positions relatives %>
    <% if enemies.any? %>
      <div class="mb-2">
        <small class="text-light d-block mb-1">Positions :</small>
        <% enemies.each do |enemy| %>
          <% pos = positions.find { |p| [p.participant_a_id, p.participant_b_id].sort == [participant.id, enemy.id].sort } %>
          <% next unless pos %>
          <% relative = pos.relative_position_for(participant) %>
          <span class="badge bg-<%= relative_position_badge_color(relative) %> me-1 mb-1" style="font-size: 0.7rem;">
            <%= enemy.ship_name %> : <%= relative_position_label(relative) %>
            <% if pos.blind_spot_for?(participant) %> · angle mort<% end %>
          </span>
        <% end %>
      </div>
    <% end %>

    <%# Armement %>
    <% if weapons.any? %>
      <div class="mb-2">
        <small class="text-light d-block mb-1">Armes :</small>
        <% weapons.each do |weapon| %>
          <div class="d-flex align-items-center justify-content-between" style="font-size: 0.8rem;">
            <span>
              <%= SpaceCombatStats.weapon_label(weapon) %>
              <small class="text-muted">(<%= SpaceCombatRules.normalize_weapon_type(weapon.weapon_type) %>)</small>
            </span>
            <span>
              <small class="text-muted me-1">
                dég. <%= format_dice(weapon.damage_mastery, weapon.damage_bonus) %> ·
                visée <%= format_dice(weapon.aim_mastery, weapon.aim_bonus) %>
              </small>
              <% if ammo_label(weapon) %>
                <span class="badge bg-dark"><%= ammo_label(weapon) %></span>
              <% end %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Flags de dommage (MJ) %>
    <% if is_mj %>
      <div class="mb-2">
        <small class="text-light d-block mb-1">Statuts (MJ) :</small>
        <div class="d-flex flex-wrap gap-1">
          <% Ship::COMBAT_DAMAGE_FLAGS.each do |flag| %>
            <button class="btn btn-sm <%= ship.send(flag) ? 'btn-danger' : 'btn-outline-secondary' %>"
                    style="font-size: 0.65rem; padding: 2px 6px;"
                    data-action="click->space-combat#toggleDamageFlag"
                    data-participant-id="<%= participant.id %>"
                    data-flag="<%= flag %>">
              <%= Ship::DAMAGE_FLAG_LABELS[flag] %>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if can_act && !participant.out_of_combat? %>
      <%= render "space_combat/ship_actions",
                 participant: participant, combat: combat, positions: positions,
                 enemies: live_enemies, weapons: weapons, current_user: current_user,
                 crew_position: crew_position %>
    <% elsif participant.out_of_combat? %>
      <div class="mt-2 border-top pt-2 text-center text-muted">
        <small><%= participant.has_fled? ? "Ce vaisseau a quitté le combat." : "Ce vaisseau est détruit." %></small>
      </div>
    <% end %>
  </div>
</div>
